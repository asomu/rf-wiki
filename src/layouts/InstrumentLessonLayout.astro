---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/astro/Breadcrumbs.astro';
import InstrumentLearningMap from '../components/astro/InstrumentLearningMap.astro';
import { getInstrument, getInstrumentChapter, type InstrumentChapterId, type InstrumentId } from '../data/instruments';

export interface Props {
  title: string;
  description: string;
  instrumentId: InstrumentId;
  chapterId: InstrumentChapterId;
  estimatedMinutes?: number;
}

const { title, description, instrumentId, chapterId, estimatedMinutes } = Astro.props;
const instrument = getInstrument(instrumentId);
if (!instrument) throw new Error(`Unknown instrument: ${instrumentId}`);
const chapter = getInstrumentChapter(instrument.id, chapterId);
const chapterIndex = instrument.chapters.findIndex(({ id }) => id === chapterId);
const previousChapter = chapterIndex > 0 ? instrument.chapters[chapterIndex - 1] : undefined;
const nextChapter = chapterIndex >= 0 ? instrument.chapters[chapterIndex + 1] : undefined;
const layerItems = [
  { id: 'intuition', label: '직관', question: '무엇이 움직이나?' },
  { id: 'bench', label: '조작·해석', question: '어떻게 제어하나?' },
  { id: 'theory', label: '수식·규격', question: '어떻게 검증하나?' },
] as const;
---

<BaseLayout title={title} description={description} currentPath={Astro.url.pathname} bodyClass="lesson-page instrument-lesson-page">
  <main class="lesson-shell">
    <InstrumentLearningMap instrumentId={instrument.id} currentChapter={chapterId} />

    <div class="lesson-intro" data-pagefind-body>
      <Breadcrumbs items={[
        { label: '장비 스터디', href: '/instruments/' },
        { label: instrument.displayName, href: `/instruments/${instrument.route}/` },
        { label: chapter?.shortTitle ?? title },
      ]} />
      <header class="lesson-heading">
        <p class="context-line">
          <span>Keysight {instrument.model}</span>
          <span>{instrument.rangeLabel}</span>
          <span>Firmware {instrument.firmwareScope}</span>
          {estimatedMinutes && <span>{estimatedMinutes}분</span>}
        </p>
        <h1>{title}</h1>
        <p>{description}</p>
      </header>
    </div>

    <nav class="layer-rail" aria-label="학습 깊이">
      <ol>
        {layerItems.map((item, index) => (
          <li>
            <a href={`#${item.id}`} aria-current={index === 0 ? 'step' : undefined}>
              <span class="layer-index">{index + 1}</span>
              <span><strong>{item.label}</strong><small>{item.question}</small></span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <article class="lesson-article" data-pagefind-body>
      <div class="lesson-content"><slot /></div>
      <nav class="instrument-chapter-nav" aria-label={`${instrument.displayName} 챕터 이동`}>
        {previousChapter ? (
          <a class="instrument-chapter-nav__previous" href={`/instruments/${instrument.route}/${previousChapter.id}/`}>
            <small>이전 챕터</small>
            <strong>{previousChapter.shortTitle}</strong>
          </a>
        ) : <span aria-hidden="true"></span>}
        {nextChapter ? (
          <a class="instrument-chapter-nav__next" href={`/instruments/${instrument.route}/${nextChapter.id}/`}>
            <small>다음 챕터 · {nextChapter.order}/{instrument.chapters.length}</small>
            <strong>{nextChapter.shortTitle} →</strong>
          </a>
        ) : (
          <a class="instrument-chapter-nav__next" href={`/instruments/${instrument.route}/`}>
            <small>{instrument.code} 스터디 정리</small>
            <strong>{instrument.displayName} 허브로 →</strong>
          </a>
        )}
      </nav>
    </article>
  </main>
</BaseLayout>
