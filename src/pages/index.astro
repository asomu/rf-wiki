---
import BaseLayout from '../layouts/BaseLayout.astro';
import SignalSpine from '../components/astro/SignalSpine.astro';
import { curriculum, totalEstimatedMinutes, totalLessonCount } from '../data/curriculum';

const totalHours = Math.round(totalEstimatedMinutes / 60);
const firstModule = curriculum[0]!;
const progressModules = curriculum.map((module) => ({
  id: module.id,
  title: module.representativeLessonTitle,
  summary: module.summary,
  href: module.representativeLessonHref,
  completionLabIds: module.completionLabIds
}));
const spectrumIqCompletionNote = curriculum.find((module) => module.id === 'spectrum-iq')?.completionNote;
---

<BaseLayout
  title="RF Wiki"
  description="장비 설정, RF 신호 경로, 계산 모델과 화면 변화를 한 시야에서 연결하는 개인용 학습 Wiki"
  currentPath="/"
>
  <main class="home-shell" data-pagefind-body>
    <header class="home-heading">
      <p class="context-line">
        <span>개인 bench</span>
        <span>6개 학습 축</span>
        <span>예측 → 조작 → 설명</span>
      </p>
      <h1>설정값 하나가 trace를 바꾸는 경로를 따라갑니다.</h1>
      <p>
        용어를 따로 외우지 않습니다. 물리 신호가 계측기 안에서 처리되고 화면의 모양과 실무 판단으로 이어지는 과정을 같은 장면에서 확인합니다.
      </p>
    </header>

    <section
      class="home-bench"
      aria-labelledby="current-position-title"
      data-home-progress
      data-progress-modules={JSON.stringify(progressModules)}
    >
      <div class="current-position">
        <div class="current-position__heading">
          <div>
            <p class="data-label" data-progress-position>현재 위치 · 시작점</p>
            <h2 id="current-position-title" data-progress-title>{firstModule.representativeLessonTitle}</h2>
          </div>
          <p class="progress-readout"><span data-progress-count>0</span> / {totalLessonCount}</p>
        </div>

        <p class="current-position__summary" data-progress-summary>{firstModule.summary}</p>

        <dl class="bench-conditions" aria-label="RF Wiki 기본 bench 조건">
          <div><dt>Source</dt><dd>Signal Studio</dd></div>
          <div><dt>DUT</dt><dd>50 Ω fixture</dd></div>
          <div><dt>Acquisition</dt><dd>SA · VSA · VNA</dd></div>
          <div><dt>Display</dt><dd>Linked views</dd></div>
        </dl>

        <SignalSpine label="모든 학습 축에서 공통으로 사용하는 Source에서 Display까지 신호 경로" />

        <div class="current-position__action">
          <div class="progress-track" role="progressbar" aria-label="전체 학습 진도 · 0/6 완료" aria-valuemin="0" aria-valuemax={totalLessonCount} aria-valuenow="0" data-progress-bar>
            <span style="--progress: 0%" data-progress-fill></span>
          </div>
          <a class="button-primary" href={firstModule.representativeLessonHref} data-progress-action>첫 실험 시작</a>
        </div>
      </div>

      <aside class="bench-protocol" aria-labelledby="bench-protocol-title">
        <div class="bench-protocol__heading">
          <p class="data-label">모든 실험의 공통 순서</p>
          <h2 id="bench-protocol-title">화면을 보기 전에 방향부터 정합니다.</h2>
        </div>
        <ol>
          <li>
            <span>설정</span>
            <p>바꿀 control과 영향을 받는 Signal Spine stage를 고릅니다.</p>
          </li>
          <li>
            <span>예측</span>
            <p>trace, IQ, grid 또는 Smith point가 움직일 방향을 먼저 고정합니다.</p>
          </li>
          <li>
            <span>결과</span>
            <p>같은 계산 상태를 linked view에서 동시에 관찰합니다.</p>
          </li>
          <li>
            <span>해석</span>
            <p>직접 효과, 화면 결과, 시간·noise·uncertainty 비용을 설명합니다.</p>
          </li>
        </ol>
        <p class="bench-protocol__scope">기본 기준: connectorized fixture · 50 Ω · 3GPP Release 17</p>
        {spectrumIqCompletionNote && <p class="bench-protocol__scope">{spectrumIqCompletionNote}</p>}
      </aside>
    </section>

    <section class="curriculum-section" id="curriculum" aria-labelledby="curriculum-title">
      <header class="section-heading">
        <div>
          <p class="data-label">전체 학습 지도</p>
          <h2 id="curriculum-title">어느 지점에서 신호의 그림이 끊기나요?</h2>
        </div>
        <p>{curriculum.length}개 축 · {totalLessonCount}개 lesson · 약 {totalHours}시간</p>
      </header>

      <ol class="curriculum-route">
        {curriculum.map((module, index) => (
          <li class:list={{ 'is-start': index === 0 }}>
            <div class="curriculum-route__axis" aria-hidden="true">
              <span>{String(module.order).padStart(2, '0')}</span>
              <i></i>
            </div>
            <div class="curriculum-route__content">
              <div class="curriculum-route__heading">
                <div>
                  <p>{module.shortTitle}</p>
                  <h3>{module.title}</h3>
                </div>
                <p class="module-duration">{module.lessonCount}개 lesson · {module.estimatedMinutes}분</p>
              </div>
              <p class="curriculum-route__question">{module.question}</p>
              <p class="curriculum-route__summary">{module.summary}</p>
              <ul class="topic-line" aria-label={`${module.shortTitle} 주요 주제`}>
                {module.topics.map((topic) => <li>{topic}</li>)}
              </ul>
              <a href={module.representativeLessonHref}>
                {index === 0 ? '이 단계에서 시작' : '학습 화면 열기'}
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="home-measurement-contract" aria-labelledby="measurement-contract-title">
      <div>
        <p class="data-label">측정 해석 계약</p>
        <h2 id="measurement-contract-title">숫자에는 항상 조건이 붙습니다.</h2>
      </div>
      <dl>
        <div><dt>기준면</dt><dd>cable·fixture·calibration이 포함되는 위치를 표시합니다.</dd></div>
        <div><dt>Convention</dt><dd>FFT 정규화, S-parameter 방향, 전력·이득 정의를 함께 씁니다.</dd></div>
        <div><dt>한계</dt><dd>교육 모델과 실제 장비의 noise, uncertainty, compliance 차이를 숨기지 않습니다.</dd></div>
      </dl>
    </section>
  </main>

  <script>
    import {
      PROGRESS_STORAGE_KEY,
      readLearningProgress,
      summarizeModuleProgress,
    } from '../lib/progress';

    interface HomeProgressModule {
      id: string;
      title: string;
      summary: string;
      href: string;
      completionLabIds: string[];
    }

    const root = document.querySelector<HTMLElement>('[data-home-progress]');
    if (root) {
      const modules = JSON.parse(root.dataset.progressModules ?? '[]') as HomeProgressModule[];
      const position = root.querySelector<HTMLElement>('[data-progress-position]');
      const title = root.querySelector<HTMLElement>('[data-progress-title]');
      const summary = root.querySelector<HTMLElement>('[data-progress-summary]');
      const count = root.querySelector<HTMLElement>('[data-progress-count]');
      const bar = root.querySelector<HTMLElement>('[data-progress-bar]');
      const fill = root.querySelector<HTMLElement>('[data-progress-fill]');
      const action = root.querySelector<HTMLAnchorElement>('[data-progress-action]');

      const renderProgress = () => {
        if (modules.length === 0) return;
        const progress = readLearningProgress(window.localStorage);
        const state = summarizeModuleProgress(modules, progress);
        const allComplete = state.completedCount === modules.length;
        const current = modules.find((module) => module.id === state.nextModuleId) ?? modules.at(-1);
        if (!current) return;

        if (position) {
          position.textContent = allComplete
            ? '전체 학습 완료'
            : state.completedCount === 0
              ? '현재 위치 · 시작점'
              : `이어갈 위치 · ${state.completedCount}/${modules.length} 완료`;
        }
        if (title) title.textContent = allComplete ? '여섯 학습 축을 모두 닫았습니다.' : current.title;
        if (summary) {
          summary.textContent = allComplete
            ? '예측, 설정 조작, 원인 설명을 모두 완료했습니다. 필요한 실험을 다시 열어 조건을 바꿔보세요.'
            : current.summary;
        }
        if (count) count.textContent = String(state.completedCount);
        if (bar) {
          bar.setAttribute('aria-valuenow', String(state.completedCount));
          bar.setAttribute('aria-label', `전체 학습 진도 · ${state.completedCount}/${modules.length} 완료`);
        }
        if (fill) fill.style.setProperty('--progress', `${(state.completedCount / modules.length) * 100}%`);
        if (action) {
          action.href = current.href;
          action.textContent = allComplete
            ? '완료한 실험 다시 보기'
            : state.completedCount === 0
              ? '첫 실험 시작'
              : '이어서 학습';
        }
      };

      renderProgress();
      window.addEventListener('pageshow', renderProgress);
      window.addEventListener('storage', (event) => {
        if (event.key === PROGRESS_STORAGE_KEY) renderProgress();
      });
    }
  </script>
</BaseLayout>
