---
import { getCollection } from 'astro:content';

export interface Props {
  currentSlug?: string;
}

const { currentSlug } = Astro.props;
const lessons = (await getCollection('dvtLesson', ({ data }) => data.status === 'ready'))
  .sort((a, b) => a.data.order - b.data.order);
const currentLesson = lessons.find(({ id }) => id === currentSlug);
---

<aside class="learning-map dvt-learning-map" aria-label="PAMiD DVT 시니어 경로 학습 지도">
  <details class="learning-map__disclosure" open>
    <summary>
      <span>PAMiD DVT</span>
      <strong>{currentLesson?.data.shortTitle ?? '전체 지도'}</strong>
    </summary>
    <div class="learning-map__body">
      <div class="learning-map__heading">
        <p>LTE FDD first</p>
        <span>{lessons.length} lessons</span>
      </div>
      <nav aria-label="DVT lesson">
        <ol>
          {lessons.map(({ id, data }) => {
            const isCurrent = id === currentSlug;
            return (
              <li class:list={{ 'is-current': isCurrent }}>
                <a href={`/dvt/${id}/`} aria-current={isCurrent ? 'page' : undefined}>
                  <span class="module-index">{String(data.order).padStart(2, '0')}</span>
                  <span class="learning-map__label">
                    <strong>{data.shortTitle}</strong>
                    {isCurrent && <small>{data.question}</small>}
                  </span>
                </a>
              </li>
            );
          })}
        </ol>
      </nav>
      <a class="learning-map__glossary" href="/dvt/">DVT 전체 지도로 →</a>
      <a class="learning-map__glossary" href="/glossary/">막힌 용어 먼저 찾기 →</a>
    </div>
  </details>
</aside>

<script is:inline>
  (() => {
    const disclosure = document.currentScript?.previousElementSibling?.querySelector('.learning-map__disclosure');
    if (!(disclosure instanceof HTMLDetailsElement)) return;
    const compact = window.matchMedia('(max-width: 1180px)');
    const sync = () => compact.matches ? disclosure.removeAttribute('open') : disclosure.setAttribute('open', '');
    sync();
    compact.addEventListener('change', sync);
  })();
</script>

<style>
  .dvt-learning-map li.is-current > a {
    box-shadow: inset 0 calc(var(--stroke-hairline) * -2) 0 var(--color-active);
    color: var(--color-ink);
    background: color-mix(in srgb, var(--color-active) 7%, var(--color-surface));
  }
</style>
