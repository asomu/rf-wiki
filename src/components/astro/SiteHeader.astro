---
import SearchField from './SearchField.astro';

export interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const isLearning = currentPath === '/' || currentPath.startsWith('/learn/');
const isInstruments = currentPath.startsWith('/instruments/');
const isCellular = currentPath.startsWith('/cellular/');
const isGlossary = currentPath.startsWith('/glossary');
const currentNavLabel = isCellular
  ? '3GPP·PAMiD'
  : isInstruments
    ? '장비 스터디'
    : isGlossary
      ? '용어 사전'
      : isLearning
        ? 'RF 개념'
        : '사이트 탐색';
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="wordmark" href="/">
      <span class="wordmark__rf">RF</span>
      <span class="wordmark__divider" aria-hidden="true"></span>
      <span>WIKI</span>
      <span class="visually-hidden">홈</span>
    </a>

    <p class="release-context">
      <span class="release-context__marker" aria-hidden="true"></span>
      교육용 계산 모델
    </p>

    <nav class="primary-nav" aria-label="주요 탐색">
      <a href="/" aria-current={isLearning ? 'page' : undefined}>RF 개념</a>
      <a href="/cellular/" aria-current={isCellular ? 'page' : undefined}>3GPP·PAMiD</a>
      <a href="/instruments/" aria-current={isInstruments ? 'page' : undefined}>장비 스터디</a>
      <a href="/glossary/" aria-current={isGlossary ? 'page' : undefined}>용어 사전</a>
    </nav>

    <details class="mobile-primary-nav">
      <summary><span>{currentNavLabel}</span><span aria-hidden="true">탐색</span></summary>
      <nav aria-label="모바일 주요 탐색">
        <a href="/" aria-current={isLearning ? 'page' : undefined}>RF 개념</a>
        <a href="/cellular/" aria-current={isCellular ? 'page' : undefined}>3GPP·PAMiD</a>
        <a href="/instruments/" aria-current={isInstruments ? 'page' : undefined}>장비 스터디</a>
        <a href="/glossary/" aria-current={isGlossary ? 'page' : undefined}>용어 사전</a>
      </nav>
    </details>

    <div class="header-search">
      <SearchField id="header-search" compact />
    </div>
  </div>
</header>
