---
import { curriculum, getCurriculumModule, type CurriculumModuleId } from '../../data/curriculum';

export interface Props {
  currentModule?: CurriculumModuleId;
}

const { currentModule } = Astro.props;
const current = getCurriculumModule(currentModule);
---

<aside class="learning-map" aria-label="전체 학습 지도">
  <details class="learning-map__disclosure" open>
    <summary>
      <span>학습 지도</span>
      <strong>{current?.shortTitle ?? '전체 경로'}</strong>
    </summary>

    <div class="learning-map__body">
      <div class="learning-map__heading">
        <p>학습 경로</p>
        <span>{curriculum.length}개 축</span>
      </div>
      <nav aria-label="학습 모듈">
        <ol>
          {curriculum.map((module) => {
            const isCurrent = module.id === currentModule;
            return (
              <li class:list={{ 'is-current': isCurrent }}>
                <a href={module.representativeLessonHref} aria-current={isCurrent ? 'page' : undefined}>
                  <span class="module-index">{String(module.order).padStart(2, '0')}</span>
                  <span class="learning-map__label">
                    <strong>{module.shortTitle}</strong>
                    {isCurrent && <small>{module.question}</small>}
                  </span>
                </a>
              </li>
            );
          })}
        </ol>
      </nav>
      <a class="learning-map__glossary" href="/glossary/">막힌 용어를 먼저 찾기 →</a>
    </div>
  </details>
</aside>

<script is:inline>
  (() => {
    const disclosure = document.currentScript?.previousElementSibling?.querySelector('.learning-map__disclosure');
    if (!(disclosure instanceof HTMLDetailsElement)) return;
    const compact = window.matchMedia('(max-width: 1180px)');
    const sync = () => {
      if (compact.matches) disclosure.removeAttribute('open');
      else disclosure.setAttribute('open', '');
    };
    sync();
    compact.addEventListener('change', sync);
  })();
</script>
