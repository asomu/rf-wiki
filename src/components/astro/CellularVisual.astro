---
import CrossRatAtlas from '../cellular/CrossRatAtlas';
import GsmTimeExplorer from '../cellular/GsmTimeExplorer';
import GsmPvtLab from '../cellular/GsmPvtLab';
import CellularResourceExplorer from '../cellular/CellularResourceExplorer';
import ModulePathDiagram from '../cellular/ModulePathDiagram';
import ReceiverRecoveryLab from '../simulators/ReceiverRecoveryLab';
import DiagnosticFingerprint from './DiagnosticFingerprint.astro';
import CodingTransformDiagram from './CodingTransformDiagram.astro';
import ConstellationGuideDiagram from './ConstellationGuideDiagram.astro';
import DpdFlowDiagram from './DpdFlowDiagram.astro';
import EnvelopePaprDiagram from './EnvelopePaprDiagram.astro';
import SignalJourneyDiagram from './SignalJourneyDiagram.astro';

export interface Props {
  visual:
    | 'atlas'
    | 'gsm-time'
    | 'gsm-pvt'
    | 'resource-lte'
    | 'resource-nr'
    | 'module-path'
    | 'diagnostic'
    | 'signal-chain'
    | 'coding-chain'
    | 'constellation-guide'
    | 'envelope-papr'
    | 'receiver-recovery'
    | 'dpd-flow';
  preset?: string;
  title?: string;
}
const { visual, preset = '' } = Astro.props;
---

<div class="lesson-lab-block cellular-visual-block" id="interactive-lab">
  {visual === 'atlas' && <CrossRatAtlas client:visible />}
  {visual === 'gsm-time' && <GsmTimeExplorer client:visible preset={preset} />}
  {visual === 'gsm-pvt' && <GsmPvtLab client:visible />}
  {visual === 'resource-lte' && <CellularResourceExplorer client:visible initialRat="LTE" preset={preset} />}
  {visual === 'resource-nr' && <CellularResourceExplorer client:visible initialRat="NR" preset={preset} />}
  {visual === 'module-path' && <ModulePathDiagram client:visible preset={preset} />}
  {visual === 'diagnostic' && <DiagnosticFingerprint preset={preset} />}
  {visual === 'signal-chain' && <SignalJourneyDiagram />}
  {visual === 'coding-chain' && <CodingTransformDiagram />}
  {visual === 'constellation-guide' && <ConstellationGuideDiagram preset={preset} />}
  {visual === 'envelope-papr' && <EnvelopePaprDiagram />}
  {visual === 'receiver-recovery' && <ReceiverRecoveryLab client:visible />}
  {visual === 'dpd-flow' && <DpdFlowDiagram />}
</div>
