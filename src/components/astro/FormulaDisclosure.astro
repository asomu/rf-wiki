---
export interface Props {
  title: string;
  formula?: string;
}

const { title, formula } = Astro.props;
---

<details class="formula-disclosure">
  <summary>
    <span>수식 열기</span>
    <strong>{title}</strong>
  </summary>
  <div class="formula-disclosure__body">
    {formula && <pre class="formula-readout" tabindex="0" aria-label={`${title} 수식`}><code>{formula}</code></pre>}
    <slot />
  </div>
</details>
