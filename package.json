{
  "name": "rf-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build:site": "astro build",
    "build:search": "pagefind --site dist",
    "build": "npm run build:site && npm run build:search",
    "preview": "astro preview",
    "typecheck": "astro check",
    "check:design": "node scripts/check-design.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:visual-baselines": "node scripts/check-visual-baselines.mjs",
    "new:lesson": "node scripts/new-lesson.mjs",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:lighthouse": "npm run build && node scripts/run-lighthouse.mjs",
    "test": "npm run check:design && npm run check:content && npm run check:visual-baselines && npm run typecheck && npm run test:unit && npm run build",
    "test:all": "npm run test && npm run test:e2e && npm run audit:lighthouse"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.2",
    "@astrojs/react": "^6.0.1",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans-kr": "^5.2.8",
    "astro": "^7.0.7",
    "katex": "^0.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "lighthouse": "12.6.1",
    "pagefind": "^1.5.2",
    "playwright-core": "1.61.1",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
